# Copy to backend/.env and fill only if you want optional AI candidate mapping.
# This uses an OpenAI-compatible /chat/completions endpoint. The key never reaches the browser.
VERICATALOG_AI_ENABLED=false
VERICATALOG_AI_API_KEY=
VERICATALOG_AI_BASE_URL=
VERICATALOG_AI_MODEL=
VERICATALOG_AI_TIMEOUT_SECONDS=15
# Cost guardrail: only this many batch rows may make AI calls. Direct deterministic processing still handles all rows.
VERICATALOG_AI_BATCH_LIMIT=10
