# Local-only defaults for VeriCatalog Proof.
VERICATALOG_DB_PATH=backend/data/vericatalog.sqlite3
VERICATALOG_UPLOAD_DIR=backend/data/uploads
VERICATALOG_MAX_UPLOAD_BYTES=5242880
VERICATALOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VERICATALOG_DATABASE_URL=

# Optional OpenAI-compatible AI candidate mapper. Keep false for the deterministic demo.
# The backend reads backend/.env, which should never be committed.
VERICATALOG_AI_ENABLED=false
VERICATALOG_AI_API_KEY=
VERICATALOG_AI_BASE_URL=
VERICATALOG_AI_MODEL=
VERICATALOG_AI_TIMEOUT_SECONDS=15
VERICATALOG_AI_BATCH_LIMIT=10
